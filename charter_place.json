 "books": [
  "data merge block 269 71 -2432 {Page:0,Book:{id:\"minecraft:written_book\",count:1,components:{\"minecraft:written_book_content\":{title:\"The Lamp Charter\",author:\"Syrena, Lamp-Heir\",pages:[\"THE LAMP CHARTER\\n\\nGranted at Moonharbor by Syrena, Lamp-Heir of the Quiet Reach, to whoever will keep a light.\",\"Anyone who keeps a lamp burning may hold land in the Reach. Sign the Register at the desk and the clerk will give you a lantern and a flask of oil.\",\"The terms, as cut over the Town Hall door:\\n\\nKeep a light.\\nKeep your road.\\nLeave a chair for the stranger.\\nDo not dig where the clay is green.\",\"Your charter is your land: wherever you raise your totem, the Reach is yours to keep. Mark it on the great map behind you, so the next settler knows where the lights are.\",\"Then go and light the Round: twelve lamps, Moonwell to Tobin's lantern. Lamp II burns at this door.\"]}}}}",
  "data merge block 271 76 -2430 {Page:0,Book:{id:\"minecraft:written_book\",count:1,components:{\"minecraft:written_book_content\":{title:\"Register of Charters\",author:\"The Charter Clerks\",pages:[\"REGISTER OF CHARTERS\\nMoonharbor, the Quiet Reach\\n\\nOpened in the year the Lamp Charter was granted.\",\"Every name in this book keeps a light somewhere in the Reach. When a light goes out, the clerk draws a line through the name and the map is marked dark again.\",\"To be added to the Register: sign at the desk below, take your lantern and your oil, and raise your totem where you mean to stay.\"]}}}}"
 ],
